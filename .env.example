# Chomiii environment example — PLACEHOLDERS ONLY.
#
# This file is documentation, not configuration. Spring Boot does not load
# `.env` files automatically: it reads the profile files in backend/src/main/resources/
# (application.yml with the default profile `local`; application-local.yml for
# the local MySQL database; application-prod.yml for production PostgreSQL)
# and takes credentials from standard environment variables. Vite can load
# VITE_-prefixed frontend values from frontend/.env. Set backend variables in
# your shell or deployment environment (see README.md for PowerShell commands).
#
# Never put real credentials in this file, and never commit a filled-in copy:
# `.gitignore` keeps `.env*` out of the repository except for this example file.

# --- Backend: database credentials (read by the profile files) --------------
# Locally (default profile `local`) the app runs MySQL. Only the URL is
# defaulted, to jdbc:mysql://localhost:3306/chomiii in application-local.yml;
# you normally only set these two variables.
CHOMIII_DB_USER=your_local_db_user
CHOMIII_DB_PASSWORD=replace_with_secret

# Optional URL override for local runs (same contract as the profile default):
# CHOMIII_DB_URL=jdbc:mysql://localhost:3306/chomiii

# --- Production (profile "prod"): PostgreSQL --------------------------------
# With SPRING_PROFILES_ACTIVE=prod the same variables are read, but
# application-prod.yml requires all three from the environment without
# defaults — CHOMIII_DB_URL must be a PostgreSQL JDBC URL of the form:
#   jdbc:postgresql://HOST:5432/DATABASE
# Provide production values from the deployment's secret store, never from a
# file in this repository.
# SPRING_PROFILES_ACTIVE=prod
# CHOMIII_DB_URL=jdbc:postgresql://HOST:5432/DATABASE

# --- Frontend (optional; defaults are sensible for local development) -------
# Origin the Vite dev server proxies /api requests to (default works).
# BACKEND_URL=http://localhost:8080
# Build-time override for direct browser-to-backend calls (needs CORS or a
# same-origin reverse proxy; the backend currently has neither).
# VITE_API_BASE_URL=http://localhost:8080/api
